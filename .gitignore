# Generated workspace: footage, transcripts, renders and per-video projects
/source/*
!/source/.gitkeep
/raw/
/work/
/out/
/videos/
/exports/
/renders/
/snapshots/
/assets/
/docs/local/

# Machine-specific MCP settings; generated by Set up Cawcut
/.mcp.json
/.mcp.*.json

# Only original Cawcut commands are shared from .claude
/.claude/*
!/.claude/commands/
/.claude/commands/*
!/.claude/commands/cawcut-*.md
/.agents/
/skills-lock.json
/.skill-lock.json

# Dependencies and caches, at any depth
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.cache/
.hyperframes/
.npm/
.uv/
.pytest_cache/
.env
.env.*
!.env.example

# Media anywhere in this workflow repository
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.wav
*.mp3
*.aac
*.flac
*.png
*.jpg
*.jpeg
*.gif
*.heic
*.fcpxml
*.fcpbundle/
*.srt
*.vtt

# OS/editor files and local logs
.DS_Store
._*
*.log
.idea/
.vscode/
*~
